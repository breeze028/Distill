{
  "name": "distill",
  "version": "0.1.0",
  "description": "Local-first desktop voice note library for imported iPhone voice memos.",
  "main": ".vite/build/index.js",
  "private": true,
  "scripts": {
    "dev": "electron-forge start",
    "start": "electron-forge start",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "build": "electron-forge package",
    "lint": "tsc --noEmit",
    "test": "pnpm rebuild:node-native && vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "setup:stt": "powershell -ExecutionPolicy Bypass -File scripts/setup-stt.ps1",
    "smoke:stt": "node tests/e2e/real-stt-smoke.cjs",
    "rebuild:node-native": "pnpm rebuild better-sqlite3"
  },
  "dependencies": {
    "@electron-forge/plugin-vite": "^7.11.2",
    "@vitejs/plugin-react": "^4.7.0",
    "better-sqlite3": "^12.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "electron-squirrel-startup": "^1.0.1",
    "lucide-react": "^0.468.0",
    "music-metadata": "^11.9.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "tailwind-merge": "^3.3.1",
    "zod": "^4.1.5",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.11.2",
    "@electron-forge/maker-deb": "^7.11.2",
    "@electron-forge/maker-rpm": "^7.11.2",
    "@electron-forge/maker-squirrel": "^7.11.2",
    "@electron-forge/maker-zip": "^7.11.2",
    "@electron-forge/plugin-auto-unpack-natives": "^7.11.2",
    "@playwright/test": "^1.55.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.18.1",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "autoprefixer": "^10.4.21",
    "electron": "^38.0.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.9.2",
    "vite": "^6.4.3",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=20.11.0",
    "pnpm": ">=9"
  }
}
